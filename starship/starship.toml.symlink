# Starship prompt — used as fallback when p10k is unavailable (SSH, CI, minimal terminals)
# Activate by running: eval "$(starship init zsh)" in your shell

format = """
$username\
$hostname\
$directory\
$git_branch\
$git_state\
$git_status\
$kubernetes\
$cmd_duration\
$line_break\
$character"""

[character]
success_symbol = "[❯](bold #A3BE8C)"
error_symbol = "[❯](bold #BF616A)"

[username]
show_always = false
format = "[$user]($style)@"
style_user = "bold #EBCB8B"

[hostname]
ssh_only = true
format = "[$hostname](bold #88C0D0) "

[directory]
truncation_length = 3
truncate_to_repo = true
style = "bold #81A1C1"

[git_branch]
format = "[$symbol$branch]($style) "
symbol = " "
style = "bold #B48EAD"

[git_status]
format = '([$all_status$ahead_behind]($style) )'
conflicted = "⚡"
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
untracked = "?"
stashed = "$"
modified = "!"
staged = "+"
renamed = "»"
deleted = "✘"
style = "bold #BF616A"

[kubernetes]
format = '[☸ $context\($namespace\)](bold #5E81AC) '
disabled = false

[cmd_duration]
min_time = 4_000
format = "[$duration](bold #EBCB8B) "

[golang]
format = "[ $version](bold #88C0D0) "

[java]
format = "[ $version](bold #BF616A) "

[nodejs]
format = "[ $version](bold #A3BE8C) "

[rust]
format = "[ $version](bold #D08770) "

[python]
format = "[$virtualenv](bold #EBCB8B) "
