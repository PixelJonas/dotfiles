#!/usr/bin/env bash
#
# setup-localrc — detect the current system, copy localrc.example to ~/.localrc
# if it doesn't already exist, uncomment platform-specific sections, and
# interactively prompt the user to fill in values they want to set.

cd "$(dirname "$0")/.."
DOTFILE_HOME=$(pwd -P)
EXAMPLE="$DOTFILE_HOME/zsh/localrc.example"
DEST="$HOME/.localrc"

# ── helpers ──────────────────────────────────────────────────────────────────

info()    { printf "\r  [ \033[00;34m..\033[0m ] %s\n" "$1"; }
success() { printf "\r\033[2K  [ \033[00;32mOK\033[0m ] %s\n" "$1"; }
warn()    { printf "\r  [ \033[0;33m!!\033[0m ] %s\n" "$1"; }
ask()     { printf "\r  [ \033[0;33m??\033[0m ] %s " "$1"; }

# Portable sed -i: BSD sed (macOS) requires an explicit backup-extension argument.
sedi() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    sed -i '' "$@"
  else
    sed -i "$@"
  fi
}

# ── detect platform ───────────────────────────────────────────────────────────

detect_platform() {
  local os
  os="$(uname -s)"

  case "$os" in
    Darwin)
      PLATFORM="macos"
      ;;
    Linux)
      if [[ -f /etc/os-release ]]; then
        # Bazzite is an immutable Fedora spin — detect via ID or VARIANT_ID
        if grep -qiE '^ID=bazzite|^VARIANT_ID=bazzite' /etc/os-release; then
          PLATFORM="bazzite"
        elif grep -qi '^ID=.*ubuntu\|^ID_LIKE=.*ubuntu' /etc/os-release; then
          PLATFORM="ubuntu"
        else
          PLATFORM="linux"
        fi
      else
        PLATFORM="linux"
      fi
      ;;
    *)
      PLATFORM="unknown"
      ;;
  esac

  info "Detected platform: $PLATFORM"
}

# ── copy & platform-uncomment ─────────────────────────────────────────────────

setup_localrc() {
  if [[ -f "$DEST" ]]; then
    success "~/.localrc already exists — skipping copy"
    return 0
  fi

  info "Copying localrc.example to ~/.localrc"
  cp "$EXAMPLE" "$DEST"

  # Uncomment the Steam Tinker Launch PATH block — only on Bazzite
  if [[ "$PLATFORM" == "bazzite" ]]; then
    info "Enabling Bazzite/SteamTinkerLaunch PATH block"
    # The block spans two comment lines; strip the leading '# ' from both
    sedi \
      -e '/Linux\/Bazzite.*Steam Tinker Launch/{n; s|^# ||; n; s|^# ||}' \
      "$DEST"
  fi

  success "~/.localrc created"
}

# ── interactive value prompts ─────────────────────────────────────────────────

# get_value VAR — print the current uncommented value of VAR (empty if unset).
get_value() {
  local var="$1"
  local line
  line=$(grep -E "^[[:space:]]*export ${var}=" "$DEST" 2>/dev/null | head -n1)
  [[ -z "$line" ]] && return 0
  printf '%s' "$line" | sed -E "s|^[[:space:]]*export ${var}=\"?([^\"]*)\"?[[:space:]]*$|\1|"
}

# write_value VAR VALUE — set or replace the export line for VAR in ~/.localrc.
write_value() {
  local var="$1"
  local value="$2"

  if grep -qE "^[[:space:]]*export ${var}=" "$DEST"; then
    sedi "s|^[[:space:]]*export ${var}=.*|export ${var}=\"${value}\"|" "$DEST"
  elif grep -q "^# export ${var}" "$DEST"; then
    sedi "s|^# export ${var}=.*|export ${var}=\"${value}\"|" "$DEST"
  else
    echo "export ${var}=\"${value}\"" >> "$DEST"
  fi
}

# prompt_value VAR DESCRIPTION
#   If VAR is already set in ~/.localrc, shows the current value and asks if the
#   user wants to change it. Otherwise asks if they want to set it. Empty input
#   leaves the existing state untouched.
prompt_value() {
  local var="$1"
  local desc="$2"
  local current value yn
  current=$(get_value "$var")

  if [[ -n "$current" ]]; then
    ask "$var is set to \"$current\" — change it? [y/N]"
    read -r yn
    echo
    if [[ ! "$yn" =~ ^[Yy]$ ]]; then
      info "Keeping $var unchanged"
      return
    fi
    ask "  Enter new value for $var:"
    read -r value
    echo
    if [[ -z "$value" ]]; then
      warn "No value entered — keeping $var unchanged"
      return
    fi
    write_value "$var" "$value"
    success "Updated $var"
    return
  fi

  ask "Set $var ($desc)? [y/N]"
  read -r yn
  echo
  if [[ ! "$yn" =~ ^[Yy]$ ]]; then
    info "Skipping $var — keeping it commented"
    return
  fi
  ask "  Enter value for $var:"
  read -r value
  echo
  if [[ -z "$value" ]]; then
    warn "No value entered — leaving $var commented"
    return
  fi
  write_value "$var" "$value"
  success "Set $var"
}

# prompt_projects — special handler for PROJECTS + PROJECT_PATHS (same value).
prompt_projects() {
  local current value yn
  current=$(get_value "PROJECTS")

  if [[ -n "$current" ]]; then
    ask "PROJECTS is set to \"$current\" — change it? [y/N]"
    read -r yn
    echo
    if [[ ! "$yn" =~ ^[Yy]$ ]]; then
      info "Keeping PROJECTS unchanged"
      return
    fi
    ask "  Enter new path (default: $current):"
    read -r value
    echo
    value="${value:-$current}"
  else
    ask "Set PROJECTS directory (used by the \`c\` function)? [y/N]"
    read -r yn
    echo
    if [[ ! "$yn" =~ ^[Yy]$ ]]; then
      info "Skipping PROJECTS — keeping it commented"
      return
    fi
    ask "  Enter path (default: $HOME/projects):"
    read -r value
    echo
    value="${value:-$HOME/projects}"
  fi

  write_value "PROJECTS" "$value"
  if grep -qE "^[[:space:]]*PROJECT_PATHS=" "$DEST"; then
    sedi "s|^[[:space:]]*PROJECT_PATHS=.*|PROJECT_PATHS=(\"${value}\")|" "$DEST"
  elif grep -q "^# PROJECT_PATHS=" "$DEST"; then
    sedi "s|^# PROJECT_PATHS=.*|PROJECT_PATHS=(\"${value}\")|" "$DEST"
  else
    echo "PROJECT_PATHS=(\"${value}\")" >> "$DEST"
  fi
  success "Set PROJECTS → $value"
}

# ── main ──────────────────────────────────────────────────────────────────────

echo ''
detect_platform
setup_localrc
echo ''
info "Let's configure ~/.localrc for this machine."
info "Press Enter or 'n' to skip any value."
echo ''

prompt_projects
prompt_value "GITHUB_TOKEN"     "Personal access token for GitHub"
prompt_value "ANTHROPIC_API_KEY" "API key for Anthropic / Claude"

if [[ "$PLATFORM" == "macos" ]]; then
  prompt_value "CAMERA_ON_WEBHOOK"  "Home Assistant webhook URL — fires when camera turns on"
  prompt_value "CAMERA_OFF_WEBHOOK" "Home Assistant webhook URL — fires when camera turns off"
fi

echo ''
success "~/.localrc is ready — edit it any time at $DEST"
echo ''
