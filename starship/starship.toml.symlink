# Starship prompt — used as fallback when p10k is unavailable (SSH, CI, minimal terminals)
# Activate by running: eval "$(starship init zsh)" in your shell

format = """
$username\
$hostname\
$directory\
$git_branch\
$git_state\
$git_status\
$kubernetes\
$cmd_duration\
$line_break\
$character"""

[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"

[username]
show_always = false
format = "[$user]($style)@"
style_user = "bold yellow"

[hostname]
ssh_only = true
format = "[$hostname](bold cyan) "

[directory]
truncation_length = 3
truncate_to_repo = true
style = "bold blue"

[git_branch]
format = "[$symbol$branch]($style) "
symbol = " "
style = "bold purple"

[git_status]
format = '([$all_status$ahead_behind]($style) )'
conflicted = "⚡"
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
untracked = "?"
stashed = "$"
modified = "!"
staged = "+"
renamed = "»"
deleted = "✘"
style = "bold red"

[kubernetes]
format = '[☸ $context\($namespace\)](bold navyblue) '
disabled = false

[cmd_duration]
min_time = 4_000
format = "[$duration](bold yellow) "

[golang]
format = "[ $version](bold cyan) "

[java]
format = "[ $version](bold red) "

[nodejs]
format = "[ $version](bold green) "

[rust]
format = "[ $version](bold red) "

[python]
format = "[$virtualenv](bold yellow) "
